<Window x:Class="TunBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TunBox.App"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="TunBox" Height="840" Width="1280" MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PageBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <!-- 样式合并进窗口自己：测试用裸 Application 直接 new 窗口，取不到应用级资源 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TunBox;component/Assets/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <local:ModeChipConverter x:Key="ModeChip"/>
            <local:ModeChipTextConverter x:Key="ModeChipText"/>
            <local:NonEmptyToVisibilityConverter x:Key="HasText"/>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBool"/>

            <!-- 请求页「断开」列 -->
            <DataTemplate x:Key="CloseConnCell">
                <Button Content="{DynamicResource L.Common.Disconnect}" Style="{StaticResource QuietButton}"
                        Padding="6,2" FontSize="11" Click="OnCloseConnClick"/>
            </DataTemplate>

            <!-- 开关（TUN / 系统代理用）：macOS/iOS 系统开关的比例与手感，开启 = #34C759 绿 -->
            <Style x:Key="Switch" TargetType="ToggleButton">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="track" CornerRadius="13" Background="{StaticResource TrackBg}">
                                <Ellipse x:Name="knob" Width="20" Height="20" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{StaticResource ShadowColor}" Opacity="0.18" BlurRadius="5" ShadowDepth="1" Direction="270"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{StaticResource TrackOn}"/>
                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 左侧导航：图标 + 文字的横向胶囊 -->
            <Style x:Key="SideNav" TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="t" Background="Transparent" CornerRadius="10" Padding="15,11" Margin="0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="g" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="l" Text="{TemplateBinding Header}" FontSize="14.5"
                                               FontWeight="Bold" Margin="11,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="t" Property="Background" Value="{StaticResource NavHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="t" Property="Background" Value="{StaticResource BrandSoft}"/>
                                    <Setter TargetName="g" Property="Foreground" Value="{StaticResource Brand}"/>
                                    <Setter TargetName="l" Property="Foreground" Value="{StaticResource Brand}"/>
                                    <Setter TargetName="l" Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 节点卡：代理页的网格单元（名字 + 类型徽章 + 延迟），悬停微亮反馈 -->
            <Style x:Key="NodeCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource NodeRowBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NodeRowLine}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Width" Value="248"/>
                <Setter Property="Margin" Value="0,0,14,14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource NodeRowHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 模式分段控件的单个段 -->
            <Style x:Key="ModeSegment" TargetType="Button">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.82"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <TabControl Name="Shell" SelectionChanged="OnTabChanged" Background="Transparent" BorderThickness="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧栏：logo + 六页导航 + 底部退出 -->
                    <Border Grid.Column="0" Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="14,16,14,4">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/TunBox;component/Assets/logo.png" Width="28" Height="28"/>
                                    <TextBlock Text="TunBox" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brand}" VerticalAlignment="Center"
                                               Margin="9,0,0,0"/>
                                </StackPanel>
                                <Border Background="{StaticResource IconBg}" CornerRadius="6" Padding="6,2"
                                        HorizontalAlignment="Left" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding VersionText, StringFormat=v{0}}" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,14">
                                <Button Content="{DynamicResource L.Nav.Exit}" Style="{StaticResource QuietButton}"
                                        Padding="10,6" Command="{Binding ExitCommand}"
                                        ToolTip="{DynamicResource L.Nav.ExitTip}"/>
                            </StackPanel>
                            <StackPanel IsItemsHost="True" Margin="10,14,10,0"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 页头：左边页名，右边实时速率 -->
                        <Border Grid.Row="0" Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
                            <Grid>
                                <TextBlock Text="{Binding ActivePage}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TrafficText}" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           MaxWidth="520" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Height="42" Margin="18,6,18,0"
                                  Visibility="{Binding ShowSaveButton, Converter={StaticResource BoolVis}}">
                                <Button Content="{DynamicResource L.Common.SaveSettings}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Padding="16,7" FontWeight="Bold"
                                        Command="{Binding SaveAllCommand}"
                                        ToolTip="{DynamicResource L.Common.SaveSettingsTip}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,8,18,6">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- 全站唯一的反馈位：报完 3 秒自己消失 -->
                        <Border Grid.Row="2" Background="{StaticResource IconBg}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,7"
                                Visibility="{Binding DetailText, Converter={StaticResource HasText}}">
                            <TextBlock Text="{Binding DetailText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMain}"/>
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <!-- ── 仪表盘 ─────────────────────────────────────────────────── -->
        <TabItem Header="{DynamicResource L.Nav.Dashboard}" Tag="&#xE80F;" Style="{StaticResource SideNav}">
            <!-- 共享行:左右两列逐行对齐,同一行的卡片等高(速率卡与连接卡一样大) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 连接卡:主开关 + 出站模式 + 系统代理(合并) -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 状态圆点：灰 = 未连接，琥珀 = 连接中，绿 = 已连接 -->
                                <Ellipse Width="11" Height="11" VerticalAlignment="Center" Margin="0,1,10,0"
                                         Fill="{StaticResource BoxBorder}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Running}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource L.Dash.ConnectTitle}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 桌面端的主开关：拨上去接管，拨回来放手 -->
                            <ToggleButton Style="{StaticResource SwitchLarge}" HorizontalAlignment="Right"
                                          IsChecked="{Binding IsConnected, Mode=OneWay}"
                                          Command="{Binding ToggleConnectCommand}"
                                          ToolTip="{DynamicResource L.Dash.ConnectSwitchTip}"/>
                        </Grid>
                        <TextBlock Text="{Binding RingStateText}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextMain}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Running}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,6,0,2" FontSize="12.5" Foreground="{StaticResource TextMuted}">
                            <Run Text="{DynamicResource L.Dash.CurrentEgress}"/>
                            <Run Text="{Binding SelectedEgressText, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextMain}"/>
                        </TextBlock>
                        <Border Background="{StaticResource SegTrack}" CornerRadius="10" Padding="3" Margin="0,12,0,0">
                            <UniformGrid Columns="3">
                                <Button Content="{DynamicResource L.Dash.ModeRule}" Style="{StaticResource ModeSegment}" Padding="0,7"
                                        Command="{Binding SetModeCommand}" CommandParameter="rule"
                                        Background="{Binding ProxyMode, Converter={StaticResource ModeChip}, ConverterParameter=rule}"
                                        Foreground="{Binding ProxyMode, Converter={StaticResource ModeChipText}, ConverterParameter=rule}"/>
                                <Button Content="{DynamicResource L.Dash.ModeGlobal}" Style="{StaticResource ModeSegment}" Padding="0,7" Margin="2,0"
                                        Command="{Binding SetModeCommand}" CommandParameter="global"
                                        Background="{Binding ProxyMode, Converter={StaticResource ModeChip}, ConverterParameter=global}"
                                        Foreground="{Binding ProxyMode, Converter={StaticResource ModeChipText}, ConverterParameter=global}"/>
                                <Button Content="{DynamicResource L.Dash.ModeDirect}" Style="{StaticResource ModeSegment}" Padding="0,7"
                                        Command="{Binding SetModeCommand}" CommandParameter="direct"
                                        Background="{Binding ProxyMode, Converter={StaticResource ModeChip}, ConverterParameter=direct}"
                                        Foreground="{Binding ProxyMode, Converter={StaticResource ModeChipText}, ConverterParameter=direct}"/>
                            </UniformGrid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- 实时速率:与连接卡同高(共享行拉伸),图表自动填满 -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{DynamicResource L.Dash.RateTitle}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12.5">
                                <Run Text="↑ " Foreground="{StaticResource Running}"/>
                                <Run Text="{Binding UpSpeedText, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextMain}"/>
                                <Run Text="   ↓ "/>
                                <Run Text="{Binding DownSpeedText, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextMain}"/>
                            </TextBlock>
                        </Grid>
                        <local:TrafficChart x:Name="RateChart" Grid.Row="1" Margin="0,10,0,2" MinHeight="88"/>
                    </Grid>
                </Border>

                <!-- TUN -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource L.Dash.TunTitle}" Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource TextMain}"/>
                            <ToggleButton HorizontalAlignment="Right" IsChecked="{Binding TunOn}"
                                          Style="{StaticResource Switch}" Click="OnToggleApply"/>
                        </Grid>
                        <TextBlock Text="{Binding TunStatusText}" FontSize="12" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource Brand}"/>
                        <Button Content="{DynamicResource L.Dash.TunRestartAdmin}" Style="{StaticResource GhostButton}" Padding="10,6"
                                Margin="0,8,0,0" HorizontalAlignment="Left"
                                Command="{Binding RestartAsAdminCommand}"
                                Visibility="{Binding ShowElevationHint, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>

                <!-- 快捷出口 -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource L.Dash.QuickSwitch}" Style="{StaticResource SectionTitle}"
                                       ToolTip="{DynamicResource L.Dash.QuickSwitchTip}"/>
                            <!-- 就地测速:测完下拉按延迟自动排序 -->
                            <Button Style="{StaticResource GhostButton}" Padding="8,4" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Command="{Binding TestAllCommand}"
                                    ToolTip="{DynamicResource L.Proxy.TestAllTip}">
                                <TextBlock Text="&#x26A1;" FontSize="13" Foreground="#D97706"/>
                            </Button>
                        </Grid>
                        <ComboBox ItemsSource="{Binding QuickEgressOptions}"
                                  SelectedItem="{Binding QuickEgressSelected}"
                                  Margin="0,8,0,0"
                                  ToolTip="{DynamicResource L.Dash.QuickSwitchTip}">
                            <ComboBox.ItemTemplate>
                                <!-- 名称占星号列(超长截断),延迟靠右;右侧留出下拉箭头的位置 -->
                                <DataTemplate>
                                    <Grid Margin="0,0,26,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13.5"
                                                   Foreground="{StaticResource TextMain}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Node.LatencyText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Node.LatencyBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 出口信息 -->
                                <!-- Clash 信息:内核版本 / 代理地址 / 运行时间 / 规则数量 -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="8" Background="#FFF3E0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource L.Dash.CoreInfoTitle}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Dash.CoreVersion}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CoreVersionText}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"
                                       HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoreVersionText}" Value="">
                                                <Setter Property="Text" Value="—"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Dash.SysProxyAddr}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProxyAddrText}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.Dash.MixedPortLabel}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MixedPortText}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L.Dash.Uptime}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CoreUptimeText}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource L.Dash.RulesCount}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RulesCountText}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMain}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource L.Dash.EgressTitle}" Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource TextMain}"/>
                            <Button Content="{DynamicResource L.Common.Refresh}" Style="{StaticResource GhostButton}" Padding="10,5"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                    Command="{Binding RefreshEgressCommand}"
                                    ToolTip="{DynamicResource L.Common.RefreshTip}"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Dash.EgressIp}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EgressIpText, Mode=OneWay}"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMain}" Cursor="Hand"
                                       ToolTip="{DynamicResource L.Dash.CopyIpTip}"
                                       MouseLeftButtonUp="OnCopyEgressIp"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Dash.Location}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EgressLocationText, Mode=OneWay}"
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.Dash.Carrier}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EgressCarrierText, Mode=OneWay}"
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L.Dash.LocalIp}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalIpText, Mode=OneWay}"
                                       FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
                        </Grid>
                        <Border Background="{StaticResource WarnSoft}" CornerRadius="7" Padding="8,6" Margin="0,8,0,0"
                                Visibility="{Binding ShowEgressWarn, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding EgressNote, Mode=OneWay}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource Warn}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ── 代理（配置与代理合并：一个订阅一张卡，展开显示下面的节点） ── -->
        <TabItem Header="{DynamicResource L.Nav.Proxies}" Tag="&#xE12B;" Style="{StaticResource SideNav}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NodeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource L.Proxy.SearchTip}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox SelectedValue="{Binding SortChoice}" SelectedValuePath="Tag" MinWidth="112"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                            <ComboBoxItem Content="{DynamicResource L.Proxy.Sort.Default}" Tag="default"/>
                            <ComboBoxItem Content="{DynamicResource L.Proxy.Sort.Delay}" Tag="delay"/>
                            <ComboBoxItem Content="{DynamicResource L.Proxy.Sort.Name}" Tag="name"/>
                        </ComboBox>
                        <Button Content="{DynamicResource L.Proxy.TestAll}" Style="{StaticResource GhostButton}" Padding="12,7"
                                Command="{Binding TestAllCommand}" ToolTip="{DynamicResource L.Proxy.TestAllTip}"/>
                        <Button Content="{Binding UpdateAllLabel}" Style="{StaticResource QuietButton}"
                                Padding="12,7" Margin="8,0,0,0" Command="{Binding UpdateAllCommand}"
                                ToolTip="{DynamicResource L.Profile.UpdateAllTip}"/>
                        <Button Content="{DynamicResource L.Profile.Import}" Style="{StaticResource GhostButton}"
                                Padding="13,7" Margin="8,0,0,0" Click="OnImportClick"
                                ToolTip="{DynamicResource L.Profile.ImportTip}"/>
                    </StackPanel>
                </Grid>

                <!-- smart 组可用时置顶：整个出口交给内核模型择优 -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="0"
                        Visibility="{Binding SmartAvailable, Converter={StaticResource BoolVis}}">
                    <Button Command="{Binding SelectSmartCommand}" Cursor="Hand"
                            HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent" CornerRadius="18" Padding="18,12">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource NodeRowHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x267B;&#xFE0F;" FontSize="20" VerticalAlignment="Center"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L.Proxy.Smart}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="{Binding SmartSubtitle}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="{StaticResource Running}" CornerRadius="8" Padding="10,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding SmartActive, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Button>
                </Border>

                <!-- 订阅卡片流：一订阅一卡，展开就是它的节点 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Subscriptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <Grid Margin="0,0,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="6,0,10,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                                   Foreground="{StaticResource TextMain}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding NodeCountText}" Style="{StaticResource Hint}"/>
                                                            <TextBlock Text="{Binding Updated}" Style="{StaticResource Hint}"
                                                                       Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding TrafficText}" Style="{StaticResource Hint}"
                                                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="280"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox SelectedValue="{Binding AutoUpdateChoice}"
                                                                  SelectedValuePath="Tag" MinWidth="100"
                                                                  ToolTip="{DynamicResource L.Profile.AutoUpdateTip}">
                                                            <ComboBoxItem Content="{DynamicResource L.Profile.Manual}" Tag="0"/>
                                                            <ComboBoxItem Content="{DynamicResource L.Profile.Every30}" Tag="30"/>
                                                            <ComboBoxItem Content="{DynamicResource L.Profile.Hourly}" Tag="60"/>
                                                            <ComboBoxItem Content="{DynamicResource L.Profile.Every6}" Tag="360"/>
                                                            <ComboBoxItem Content="{DynamicResource L.Profile.Every12}" Tag="720"/>
                                                            <ComboBoxItem Content="{DynamicResource L.Profile.Daily}" Tag="1440"/>
                                                        </ComboBox>
                                                        <!-- 测速这张卡当前显示的节点 -->
                                                        <Button Click="OnTestSubClick" Margin="8,0,0,0"
                                                                ToolTip="{DynamicResource L.Proxy.TestGroupTip}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="8" Padding="9,6"
                                                                            Background="#FFF3E0">
                                                                        <TextBlock Text="&#x26A1;" FontSize="13"
                                                                                   Foreground="#D97706"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <!-- 更新:Idle 静止蓝 ⟳ / Updating 顺时针旋转(700ms一圈) / 完成绿勾回弹 -->
                                                        <Button Margin="6,0,0,0" Click="OnUpdateSubClick"
                                                                ToolTip="{DynamicResource L.Profile.UpdateNowTip}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="8" Padding="9,6"
                                                                            Background="{StaticResource BrandSoft}">
                                                                        <Grid Width="14" Height="14">
                                                                            <TextBlock x:Name="glyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="13" Foreground="{StaticResource Brand}"
                                                                                       RenderTransformOrigin="0.5,0.5">
                                                                                <TextBlock.RenderTransform>
                                                                                    <RotateTransform Angle="0"/>
                                                                                </TextBlock.RenderTransform>
                                                                            </TextBlock>
                                                                            <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="13" Foreground="{StaticResource Running}"
                                                                                       RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                                                                <TextBlock.RenderTransform>
                                                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                                </TextBlock.RenderTransform>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard x:Name="spin">
                                                                                    <Storyboard RepeatBehavior="Forever">
                                                                                        <DoubleAnimation Storyboard.TargetName="glyph"
                                                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                            From="0" To="360" Duration="0:0:0.7"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                            <DataTrigger.ExitActions>
                                                                                <RemoveStoryboard BeginStoryboardName="spin"/>
                                                                            </DataTrigger.ExitActions>
                                                                        </DataTrigger>
                                                                        <!-- 成功:绿勾回弹 160ms,短暂展示(1.4s 后 VM 收掉) -->
                                                                        <DataTrigger Binding="{Binding UpdateFlash}" Value="True">
                                                                            <Setter TargetName="glyph" Property="Visibility" Value="Collapsed"/>
                                                                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard x:Name="bounce">
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetName="check"
                                                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                            From="0.4" To="1.25" Duration="0:0:0.16" AutoReverse="True"/>
                                                                                        <DoubleAnimation Storyboard.TargetName="check"
                                                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                            From="0.4" To="1.25" Duration="0:0:0.16" AutoReverse="True"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                            <DataTrigger.ExitActions>
                                                                                <RemoveStoryboard BeginStoryboardName="bounce"/>
                                                                            </DataTrigger.ExitActions>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
<Button Margin="6,0,0,0" Click="OnEditSubClick"
                                                                ToolTip="{DynamicResource L.Profile.EditTip}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="8" Padding="9,6"
                                                                            Background="#E6F4EA">
                                                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="13" Foreground="#0F9D58"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
<Button Margin="6,0,0,0" Click="OnRemoveSubClick"
                                                                ToolTip="{DynamicResource L.Profile.DeleteTip}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="8" Padding="9,6"
                                                                            Background="{StaticResource DangerButtonBg}">
                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="13" Foreground="{StaticResource Danger}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="18,4,18,16">
                                                <ProgressBar Height="4" Minimum="0" Maximum="1"
                                                             Value="{Binding TrafficRatio, Mode=OneWay}"
                                                             Foreground="{Binding TrafficRatioBrush, Mode=OneWay}"
                                                             Background="{StaticResource ProgTrack}"
                                                             Visibility="{Binding HasTraffic, Converter={StaticResource BoolVis}}"/>
                                                <ItemsControl ItemsSource="{Binding VisibleNodes}" Margin="0,12,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="row" Style="{StaticResource NodeCard}"
                                                                    MouseLeftButtonUp="OnNodeRowClick">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextMain}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                                        <Border Background="{StaticResource IconBg}" CornerRadius="5"
                                                                                Padding="5,1.5" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Kind}" FontSize="10.5"
                                                                                       Foreground="{StaticResource TextMuted}"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding LatencyText}" FontSize="12.5"
                                                                                   FontWeight="SemiBold" Margin="8,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{Binding LatencyBrush}" Cursor="Hand"
                                                                                   ToolTip="{Binding LatencyTip}"
                                                                                   MouseLeftButtonUp="OnLatencyClick"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding RowState}" Value="selected">
                                                                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Brand}"/>
                                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource BrandSoft}"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{DynamicResource L.Proxy.CardEmpty}" Style="{StaticResource Hint}"
                                                           Margin="0,10,0,0"
                                                           Visibility="{Binding HasVisibleNodes, Converter={StaticResource InverseBool}}"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource L.Profile.EmptyHint}" HorizontalAlignment="Center" Margin="0,30,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Subscriptions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ── 请求 ───────────────────────────────────────────────────── -->
        <TabItem Header="{DynamicResource L.Nav.Requests}" Tag="&#xE9D9;" Style="{StaticResource SideNav}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ConnectionSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource L.Req.SearchTip}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding RequestsCountText}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Foreground="{StaticResource TextMuted}"/>
                        <Button Content="{Binding PauseLabel}" Style="{StaticResource QuietButton}" Padding="11,7"
                                Command="{Binding PauseToggleCommand}" ToolTip="{DynamicResource L.Req.PauseTip}"/>
                        <Button Content="{DynamicResource L.Req.CloseAll}" Style="{StaticResource DangerButton}"
                                Padding="11,7" Margin="8,0,0,0"
                                Command="{Binding CloseAllConnectionsCommand}"
                                ToolTip="{DynamicResource L.Req.CloseAllTip}"/>
                    </StackPanel>
                </Grid>
                <ListView ItemsSource="{Binding ConnectionsView}" BorderThickness="0"
                          Background="Transparent" Foreground="{StaticResource TextMain}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Header="{DynamicResource L.Req.Col.Target}" Width="270" DisplayMemberBinding="{Binding Target}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.Rule}" Width="120" DisplayMemberBinding="{Binding Rule}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.Chain}" Width="110" DisplayMemberBinding="{Binding Chain}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.Process}" Width="110" DisplayMemberBinding="{Binding Process}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.Protocol}" Width="66" DisplayMemberBinding="{Binding Protocol}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.UpSpeed}" Width="82" DisplayMemberBinding="{Binding UpSpeedText}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.DownSpeed}" Width="82" DisplayMemberBinding="{Binding DownSpeedText}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.UpTotal}" Width="82" DisplayMemberBinding="{Binding UploadText}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.DownTotal}" Width="82" DisplayMemberBinding="{Binding DownloadText}"/>
                            <GridViewColumn Header="{DynamicResource L.Req.Col.Start}" Width="72" DisplayMemberBinding="{Binding Started}"/>
                            <GridViewColumn Header="" Width="64" CellTemplate="{StaticResource CloseConnCell}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <!-- ── 设置 ───────────────────────────────────────────────────── -->
        <TabItem Header="{DynamicResource L.Nav.Settings}" Tag="&#xE713;" Style="{StaticResource SideNav}">
            <StackPanel>
                <!-- 常用:一眼可见,不折叠 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Set.Section.Common}" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource L.Set.Appearance}" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding ThemeChoice}" SelectedValuePath="Tag" MinWidth="160"
                                              HorizontalAlignment="Left"
                                              ToolTip="{DynamicResource L.Set.AppearanceTip}">
                                        <ComboBoxItem Content="{DynamicResource L.Set.Theme.Auto}" Tag="auto"/>
                                        <ComboBoxItem Content="{DynamicResource L.Set.Theme.Light}" Tag="light"/>
                                        <ComboBoxItem Content="{DynamicResource L.Set.Theme.Dark}" Tag="dark"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource L.Set.Language}" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding LanguageChoice}" SelectedValuePath="Tag" MinWidth="160"
                                              HorizontalAlignment="Left"
                                              ToolTip="{DynamicResource L.Set.LanguageTip}">
                                        <ComboBoxItem Content="{DynamicResource L.Set.Lang.Auto}" Tag="auto"/>
                                        <ComboBoxItem Content="{DynamicResource L.Set.Lang.Zh}" Tag="zh"/>
                                        <ComboBoxItem Content="{DynamicResource L.Set.Lang.En}" Tag="en"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource L.Set.CloseBehavior}" Foreground="{StaticResource TextMain}" Margin="0,12,0,4"/>
                            <ComboBox SelectedValue="{Binding CloseChoice}" SelectedValuePath="Tag" MinWidth="160"
                                      HorizontalAlignment="Left"
                                      ToolTip="{DynamicResource L.Set.CloseBehaviorTip}">
                                <ComboBoxItem Content="{DynamicResource L.Set.Close.Ask}" Tag="ask"/>
                                <ComboBoxItem Content="{DynamicResource L.Set.Close.Tray}" Tag="tray"/>
                                <ComboBoxItem Content="{DynamicResource L.Set.Close.Exit}" Tag="exit"/>
                            </ComboBox>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource L.Set.AutoStart}" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMain}"/>
                                    <ToggleButton HorizontalAlignment="Right" IsChecked="{Binding AutoStartOn}"
                                                  Style="{StaticResource Switch}"/>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="{DynamicResource L.Set.SilentStart}" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMain}"
                                               ToolTip="{DynamicResource L.Set.SilentStartTip}"/>
                                    <ToggleButton HorizontalAlignment="Right" IsChecked="{Binding StartMinimizedOn}"
                                                  Style="{StaticResource Switch}"
                                                  ToolTip="{DynamicResource L.Set.SilentStartTip}"/>
                                </Grid>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="{DynamicResource L.Set.CheckUpdate}" Style="{StaticResource GhostButton}"
                                        Command="{Binding CheckUpdateCommand}"/>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Expander IsExpanded="{Binding PortsExpanded, Mode=TwoWay}"
                              Header="{DynamicResource L.Set.Section.Network}" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextMain}">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource L.Set.MixedPort}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" VerticalAlignment="Center"
                                         Text="{Binding MixedPortText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Text="{DynamicResource L.Set.HttpPort}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" VerticalAlignment="Center"
                                         Text="{Binding HttpPortText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Text="{DynamicResource L.Set.SocksPort}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" VerticalAlignment="Center"
                                         Text="{Binding SocksPortText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="3" Text="{DynamicResource L.Set.ApiPort}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" VerticalAlignment="Center"
                                         Text="{Binding ApiPortText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="4" Text="{DynamicResource L.Set.ApiSecret}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                                         Text="{Binding ApiSecretText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource L.Set.ApiSecretTip}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.Set.TunStack}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"/>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding TunStackChoice}"
                                          SelectedValuePath="Tag" MinWidth="150" HorizontalAlignment="Left"
                                          ToolTip="{DynamicResource L.Set.TunStackTip}">
                                    <ComboBoxItem Content="{DynamicResource L.Set.Stack.System}" Tag="system"/>
                                    <ComboBoxItem Content="{DynamicResource L.Set.Stack.Gvisor}" Tag="gvisor"/>
                                    <ComboBoxItem Content="{DynamicResource L.Set.Stack.Mixed}" Tag="mixed"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.Set.TunMtu}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"
                                           ToolTip="{DynamicResource L.Set.TunMtuTip}"/>
                                <TextBox Grid.Column="1" VerticalAlignment="Center"
                                         Text="{Binding TunMtuText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource L.Set.TunMtuTip}"/>
                            </Grid>
                            <CheckBox Content="{DynamicResource L.Set.TunStrictRoute}" Margin="0,12,0,0"
                                      IsChecked="{Binding TunStrictRouteOn}" ToolTip="{DynamicResource L.Set.TunStrictRouteTip}"/>
                            <CheckBox Content="{DynamicResource L.Set.TunEinat}" Margin="0,8,0,0"
                                      IsChecked="{Binding TunEinatOn}" ToolTip="{DynamicResource L.Set.TunEinatTip}"/>
                            <CheckBox Content="{DynamicResource L.Set.AllowLan}" Margin="0,12,0,0" IsChecked="{Binding AllowLan}"/>
                            <CheckBox Content="{DynamicResource L.Set.Ipv6}" Margin="0,8,0,0" IsChecked="{Binding Ipv6On}"
                                      ToolTip="{DynamicResource L.Set.Ipv6Tip}"/>
                            <CheckBox Content="{DynamicResource L.Set.DnsOverride}" Margin="0,8,0,0" IsChecked="{Binding DnsOverrideOn}"
                                      ToolTip="{DynamicResource L.Set.DnsOverrideTip}"/>
                            <TextBox Text="{Binding DnsServersText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="52" MaxHeight="110" Margin="0,6,0,0"
                                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     ToolTip="{DynamicResource L.Set.DnsServersTip}"/>
                            <TextBlock Text="{Binding DnsFeedback}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Foreground="{StaticResource Warn}"/>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Expander IsExpanded="{Binding RulesExpanded, Mode=TwoWay}"
                              Header="{DynamicResource L.Set.Section.Rules}" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextMain}">
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox Content="{DynamicResource L.Set.RulesEnable}" IsChecked="{Binding RulesOn}"/>
                            <CheckBox Content="{DynamicResource L.Set.AdRules}" Margin="0,8,0,0" IsChecked="{Binding AdRulesOn}"/>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource L.Set.GeoLib}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMain}"/>
                                <Button Content="{DynamicResource L.Common.Update}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                        HorizontalAlignment="Right" Command="{Binding RefreshGeoCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding GeoSummaryText}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                            <Expander Header="{DynamicResource L.Set.CustomRules}" Margin="0,10,0,0" FontSize="12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource L.Set.ForceDirect}" FontSize="12.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextMain}"/>
                                    <TextBox Text="{Binding ForceDirectText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="36" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="{DynamicResource L.Set.ForceProxy}" FontSize="12.5" FontWeight="Bold" Margin="0,8,0,0"
                                               Foreground="{StaticResource TextMain}"/>
                                    <TextBox Text="{Binding ForceProxyText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="36" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="{DynamicResource L.Set.CustomRules}" FontSize="12.5" FontWeight="Bold" Margin="0,8,0,0"
                                               Foreground="{StaticResource TextMain}"/>
                                    <TextBox Text="{Binding CustomRulesText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="72" MaxHeight="150" FontSize="12"
                                             FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             ToolTip="{DynamicResource L.Set.CustomRulesTip}"/>
                                    <TextBlock Text="{Binding RuleFeedback}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Foreground="{StaticResource Warn}"/>
                                    <TextBlock Text="{DynamicResource L.Set.AppRouting}" FontSize="12.5" FontWeight="Bold" Margin="0,8,0,0"
                                               Foreground="{StaticResource TextMain}"/>
                                    <ComboBox SelectedValue="{Binding AppRoutingChoice}" SelectedValuePath="Tag" Margin="0,4,0,0"
                                              MinWidth="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{DynamicResource L.Set.AppRouting.All}" Tag="all"/>
                                        <ComboBoxItem Content="{DynamicResource L.Set.AppRouting.Include}" Tag="include"/>
                                        <ComboBoxItem Content="{DynamicResource L.Set.AppRouting.Exclude}" Tag="exclude"/>
                                    </ComboBox>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AppProcesses, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MaxHeight="60" FontSize="12"
                                                 ToolTip="{DynamicResource L.Set.AppProcessesTip}"/>
                                        <Button Grid.Column="1" Content="{DynamicResource L.Set.PickApps}" Style="{StaticResource GhostButton}"
                                                Padding="10,5" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Top"
                                                Click="OnPickAppsClick"
                                                ToolTip="{DynamicResource L.Set.PickAppsTip}"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Expander IsExpanded="{Binding KernelExpanded, Mode=TwoWay}"
                              Header="{DynamicResource L.Set.Section.Kernel}" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextMain}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource L.Set.TestUrl}" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TestUrlText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource L.Set.TestUrlTip}"/>
                            <TextBlock Text="{DynamicResource L.Set.LogLevel}" Foreground="{StaticResource TextMain}" Margin="0,12,0,4"/>
                            <ComboBox SelectedValue="{Binding LogLevelChoice}" SelectedValuePath="Tag" MinWidth="160"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="{DynamicResource L.Set.LogLevel.Info}" Tag="info"/>
                                <ComboBoxItem Content="{DynamicResource L.Set.LogLevel.Debug}" Tag="debug"/>
                            </ComboBox>
                            <CheckBox Content="{DynamicResource L.Set.Sniffer}" Margin="0,12,0,0" IsChecked="{Binding SnifferOn}"/>
                            <CheckBox Content="{DynamicResource L.Set.SmartGroup}" Margin="0,6,0,0" IsChecked="{Binding SmartOn}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{DynamicResource L.Set.OpenLog}" Style="{StaticResource QuietButton}"
                                        HorizontalAlignment="Left" Command="{Binding OpenLogCommand}"/>
                                <Button Content="{DynamicResource L.Set.ViewConfig}" Style="{StaticResource QuietButton}"
                                        HorizontalAlignment="Left" Margin="8,0,0,0" Command="{Binding ViewConfigCommand}"
                                        ToolTip="{DynamicResource L.Set.ViewConfigTip}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 工具合并进设置:网络检测 / Hosts / 覆写 / 内核日志 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource L.Tools.NetCheck}" Style="{StaticResource SectionTitle}"/>
                            <Button Content="{DynamicResource L.Tools.NetCheck.Start}" Style="{StaticResource GhostButton}"
                                    Padding="12,6" HorizontalAlignment="Right" Command="{Binding RunNetCheckCommand}"
                                    ToolTip="{DynamicResource L.Tools.NetCheckTip}"/>
                        </Grid>
                        <ListView ItemsSource="{Binding NetCheckRows}" BorderThickness="0" Background="Transparent"
                                  Foreground="{StaticResource TextMain}">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="{DynamicResource L.Tools.NetCheck.Col.Url}" Width="330"
                                                    DisplayMemberBinding="{Binding Url}"/>
                                    <GridViewColumn Header="{DynamicResource L.Tools.NetCheck.Col.Direct}" Width="120"
                                                    DisplayMemberBinding="{Binding DirectText}"/>
                                    <GridViewColumn Header="{DynamicResource L.Tools.NetCheck.Col.Proxy}" Width="120"
                                                    DisplayMemberBinding="{Binding ProxyText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="{DynamicResource L.Tools.NetCheckTip}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 覆写与 Hosts:高级项,收纳 -->
                <Border Style="{StaticResource Card}">
                    <Expander IsExpanded="{Binding OverrideHostsExpanded, Mode=TwoWay}"
                              Header="{DynamicResource L.Set.Section.OverrideHosts}" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextMain}">
                        <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource L.Tools.Hosts}" Style="{StaticResource SectionTitle}"/>
                        <TextBox Text="{Binding HostsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" MinHeight="72" MaxHeight="160"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 ToolTip="{DynamicResource L.Tools.Hosts.Tip}"/>
                        <TextBlock Text="{Binding HostsFeedback}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Foreground="{StaticResource Warn}"/>
                    
                        <Grid>
                            <TextBlock Text="{DynamicResource L.Tools.Override}" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="{DynamicResource L.Tools.Override.Enable}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding OverrideEnabledOn}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource L.Tools.Override.Disabled}" Style="{StaticResource Hint}"
                                   Foreground="{StaticResource Warn}" Margin="0,6,0,0"
                                   Visibility="{Binding OverrideDisabledHint, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{DynamicResource L.Tools.Override.Merge}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{StaticResource TextMain}" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding OverrideMergeText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" MinHeight="72" MaxHeight="180"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 ToolTip="{DynamicResource L.Tools.Override.MergeTip}"/>
                        <TextBlock Text="{DynamicResource L.Tools.Override.MergeTip}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource L.Tools.Override.Script}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{StaticResource TextMain}" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding OverrideScriptText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" MinHeight="72" MaxHeight="180"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 ToolTip="{DynamicResource L.Tools.Override.ScriptTip}"/>
                        <TextBlock Text="{DynamicResource L.Tools.Override.ScriptTip}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <Button Content="{DynamicResource L.Tools.Override.Save}" Style="{StaticResource GhostButton}"
                                Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Command="{Binding SaveOverrideCommand}"
                                ToolTip="{DynamicResource L.Tools.Override.SaveTip}"/>
                    
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource L.Tools.Log}" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource L.Tools.Log.OpenFile}" Style="{StaticResource QuietButton}"
                                        Padding="10,5" FontSize="12" Command="{Binding OpenLogCommand}"/>
                                <Button Content="{DynamicResource L.Tools.Log.Clear}" Style="{StaticResource QuietButton}"
                                        Padding="10,5" FontSize="12" Margin="6,0,0,0" Click="OnClearLogClick"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Text="{Binding ToolsLogText, Mode=OneWay}" IsReadOnly="True" MinHeight="180" MaxHeight="320"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" Margin="0,8,0,0"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.Set.About}" Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource TextMain}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource L.Set.About.Core}" FontSize="12" Margin="0,0,10,0"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding CoreVersionText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- 条件绑视图模型（元素自身属性不能既做条件又做赋值目标） -->
                                                <DataTrigger Binding="{Binding CoreVersionText}" Value="">
                                                    <Setter Property="Text" Value="{DynamicResource L.Set.About.CoreUnknown}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{DynamicResource L.Set.About.Repo}" FontSize="12" Margin="0,0,10,0"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="github.com/xiaoli8571/TunBox" FontSize="12" Cursor="Hand"
                                           Foreground="{StaticResource Brand}"
                                           MouseLeftButtonUp="OnOpenRepoClick"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding VersionText, StringFormat=v{0}}" FontSize="12.5" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
