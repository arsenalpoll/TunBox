<Window x:Class="TunBox.App.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Dlg.Import.Title}" Width="430" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14"
        AllowDrop="True" Drop="OnDropFile">
    <Window.Resources>
        <!-- 样式合并进窗口自己（和主窗口同理）：对话框不能指望 App 级资源，
             否则在非 App 宿主（单测的裸 Application）里 StaticResource 直接炸 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TunBox;component/Assets/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter Property="Margin" Value="0,14,0,6"/>
            </Style>
            <Style x:Key="Placeholder" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9AA4B2"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="{DynamicResource L.Dlg.Import.Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
        <TextBlock Text="{DynamicResource L.Dlg.Import.Subtitle}"
                   Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>

        <TextBlock Text="{DynamicResource L.Dlg.Import.UrlLabel}" Style="{StaticResource FieldLabel}"/>
        <Grid>
            <TextBox x:Name="InputBox" AcceptsReturn="True" MinHeight="64" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
            <TextBlock Style="{StaticResource Placeholder}" Margin="11,9,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource L.Dlg.Import.UrlPlaceholder}"/>
        </Grid>
        <TextBlock Style="{DynamicResource Hint}" Margin="0,6,0,0"
                   Text="{DynamicResource L.Dlg.Import.UaHint}"/>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Separator Grid.Column="0" VerticalAlignment="Center" Background="{DynamicResource Line}"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource L.Dlg.Import.Or}" Margin="10,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" FontSize="11.5"/>
            <Separator Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource Line}"/>
        </Grid>

        <TextBlock Text="{DynamicResource L.Dlg.Import.FileLabel}" Style="{StaticResource FieldLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="{DynamicResource L.Dlg.Import.PickFile}" Style="{StaticResource GhostButton}" Padding="12,6" Click="OnPickFile"/>
            <TextBlock x:Name="FileName" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{DynamicResource Hint}" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <TextBlock Style="{DynamicResource Hint}" Margin="0,6,0,0"
                   Text="{DynamicResource L.Dlg.Import.DragHint}"/>

        <Button Content="{DynamicResource L.Dlg.Import.Go}" Height="38" Margin="0,18,0,0" FontWeight="Bold" Click="OnImport"/>
    </StackPanel>
</Window>
