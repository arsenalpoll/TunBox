<Window x:Class="TunBox.App.AppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Dlg.Picker.Title}" Width="430" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <!-- 样式合并进窗口自己（和主窗口同理）：对话框不能指望 App 级资源，
             否则在非 App 宿主（单测的裸 Application）里 StaticResource 直接炸 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TunBox;component/Assets/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="从已安装应用选择" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
        <TextBlock Grid.Row="0" Text="{DynamicResource L.Dlg.Picker.Subtitle}"
                   Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                   VerticalAlignment="Bottom"/>

        <TextBox x:Name="Search" Grid.Row="1" Margin="0,10,0,0" FontSize="12.5"
                 VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                 ToolTip="{DynamicResource L.Dlg.Picker.Search}"/>

        <ListBox x:Name="List" Grid.Row="2" Margin="0,8,0,0"
                 BorderBrush="{DynamicResource Line}" BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 CheckBox.Click="OnItemToggled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"
                              VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="{Binding ExeName}" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="Status" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis"/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource L.Dlg.Picker.SelectAll}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Click="OnSelectAll"/>
                <Button Content="{DynamicResource L.Dlg.Picker.ClearAll}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Margin="6,0,0,0" Click="OnSelectNone"/>
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Style="{StaticResource GhostButton}"
                    Padding="14,5" FontSize="12" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="OkButton" Grid.Column="3" Content="确定" Padding="14,5" FontSize="12"
                    FontWeight="Bold" Click="OnOk"/>
        </Grid>
    </Grid>
</Window>
