<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 暗色主题:只覆盖调色 token,控件样式仍来自 Styles.xaml。
         对齐 TunBox 鸿蒙端 resources/dark/element/color.json:
         深夜蓝底 #0B1220 + 蓝灰卡 #16223A + 品牌蓝 #3D7DFF + 强调绿 #2FD98F。
         覆盖方式:ThemeManager 在运行时把本字典合并进窗口资源,键名与 Styles.xaml 一一对应。 -->
    <SolidColorBrush x:Key="PageBg" Color="#0B1220"/>
    <SolidColorBrush x:Key="CardBg" Color="#16223A"/>
    <SolidColorBrush x:Key="CardLine" Color="#24344F"/>
    <SolidColorBrush x:Key="Brand" Color="#3D7DFF"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="TextMain" Color="#E8EEF8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A0AEC2"/>
    <SolidColorBrush x:Key="Line" Color="#24344F"/>
    <SolidColorBrush x:Key="SegTrack" Color="#24344F"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B5E"/>
    <SolidColorBrush x:Key="Warn" Color="#FFB020"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#33FFB020"/>
    <SolidColorBrush x:Key="Running" Color="#2FD98F"/>
    <SolidColorBrush x:Key="GlowIdle" Color="#330A59F7"/>
    <SolidColorBrush x:Key="GlowOn" Color="#332FD98F"/>
    <SolidColorBrush x:Key="RunningSoft" Color="#332FD98F"/>
    <SolidColorBrush x:Key="RingBorder" Color="#24344F"/>
    <SolidColorBrush x:Key="IconBg" Color="#1C2A46"/>
    <SolidColorBrush x:Key="DangerButtonBg" Color="#3A1F22"/>
    <SolidColorBrush x:Key="QuietBtnBg" Color="#1C2A46"/>
    <SolidColorBrush x:Key="QuietBtnFg" Color="#A0AEC2"/>
    <SolidColorBrush x:Key="InputHoverLine" Color="#2C4470"/>
    <SolidColorBrush x:Key="ComboHoverLine" Color="#2C4470"/>
    <SolidColorBrush x:Key="BoxBorder" Color="#2C4470"/>
    <SolidColorBrush x:Key="TrackBg" Color="#24344F"/>
    <SolidColorBrush x:Key="TrackOn" Color="#2FD98F"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2C4470"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#3A4A66"/>
    <SolidColorBrush x:Key="NodeRowBg" Color="#101A2E"/>
    <SolidColorBrush x:Key="NodeRowLine" Color="#24344F"/>
    <SolidColorBrush x:Key="NodeRowHover" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="NavHover" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="ProgTrack" Color="#24344F"/>
    <SolidColorBrush x:Key="PopupBg" Color="#16223A"/>
    <SolidColorBrush x:Key="TooltipBg" Color="#0B1220"/>
    <Color x:Key="ShadowColor">#050810</Color>
</ResourceDictionary>
